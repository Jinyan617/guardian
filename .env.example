# Gateway 连接
GATEWAY_URL=http://127.0.0.1:3060
GATEWAY_CLIENT_KEY=your_gateway_client_key

# Bark 推送地址
BARK_URL=https://api.day.app/your_bark_key/

# 数据路径（默认值可直接用）
STATE_PATH=./data/state.json
LOG_DIR=./logs
PRESENCE_PATH=./data/presence.json
GPS_PATH=./data/location.json
TASKS_PATH=./data/pending-tasks.json

# 六轴
DESIRE_STATE_PATH=./desire/state.json
DESIRE_EVENTS_PATH=./desire/events.jsonl

# 深夜静默时段（24h 格式）
NIGHT_START=01:00
NIGHT_END=06:30

# 特殊时刻（每天触发一次，格式 HH:MM）
SPECIAL_MOMENT=02:17

# 静默兜底阈值（小时）
SILENCE_FALLBACK_HOURS=4

# CC tmux session 名
CC_SESSION=claude

# AISay（桩，暂不自动回复）
AISAY_TOKEN=
